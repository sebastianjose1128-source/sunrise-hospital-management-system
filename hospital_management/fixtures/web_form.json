  "client_script": "frappe.web_form.after_load = () => {\n\n    const doctor_field = frappe.web_form.fields_dict.doctor;\n    let request_id = 0;\n\n    function load_doctors(department) {\n\n        const current_request = ++request_id;\n\n        doctor_field.set_data([]);\n        frappe.web_form.set_value(\"doctor\", \"\");\n\n        if (!department) return;\n\n        frappe.call({\n            method: \"hospital_management.sunrise_hospital_management.doctype.patient_appointment_request.patient_appointment_request.get_active_doctors_for_department\",\n\n            args: {\n                department: department\n            },\n\n            callback: (r) => {\n                if (current_request !== request_id) return;\n\n                doctor_field.set_data(r.message || []);\n            }\n        });\n    }\n\n    frappe.web_form.on(\"department\", (field, value) => {\n        load_doctors(value);\n    });\n\n    const department = frappe.web_form.get_value(\"department\");\n\n    if (department) {\n        load_doctors(department);\n    } else {\n        doctor_field.set_data([]);\n    }\n};",
